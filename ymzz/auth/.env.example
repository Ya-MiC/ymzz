# Documentation only. The service reads the host environment; this file is never auto-loaded.
NODE_ENV=production
AUTH_ORIGIN=https://accounts.your-owned-domain.example
AUTH_DATABASE=/var/lib/ymzz-auth/auth.sqlite
PORT=3100
# Required: independent cryptographically random deployment secret, >=32 characters.
AUTH_SECRET=
# Both absent = Google disabled. Redirect: <AUTH_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# All absent = email disabled. Existing verified transactional sender required.
SMTP_HOST=
SMTP_PORT=465
MAIL_HOURLY_LIMIT=100
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only with a local TLS proxy that overwrites X-Real-IP. Otherwise leave unset.
# TRUST_PROXY=loopback
