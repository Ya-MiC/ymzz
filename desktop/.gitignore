# CI/locally assembled backend payload — binaries never committed.
# The 0-byte .keep placeholder IS committed so the bundle's resource path is
# valid for a fresh clone before assembly (see resources/README.md).
resources/backend/*
!resources/backend/.keep
# Generated full icon set (icns/extra png sizes regenerated by `tauri icon` in CI;
# the committed source icons are 128x128.png, app-icon.png and icon.ico, which is
# regenerated locally so `cargo check`/`tauri build` work before CI runs).
src-tauri/icons/*.icns
src-tauri/icons/*@2x.png
src-tauri/icons/32x32.png
src-tauri/icons/512*.png
src-tauri/icons/Square*.png
src-tauri/icons/Store*.png
src-tauri/icons/android/
src-tauri/icons/ios/
